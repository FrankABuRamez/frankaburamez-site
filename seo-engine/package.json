{
  "name": "frank-seo-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Programmatic-SEO page generator for frankaburamez.tech. YAML in, static HTML out. Bun + TypeScript only.",
  "type": "module",
  "scripts": {
    "generate": "bun run bin/generate.ts",
    "dry-run": "bun run bin/generate.ts --niche all --dry-run",
    "write": "bun run bin/generate.ts --niche all --write",
    "preview": "bun run bin/generate.ts --niche all --dry-run --emit-preview",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "slugify": "^1.6.6",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.4"
  }
}
