# Clean URLs — serve foo.html for /foo
RewriteEngine On

# If a real file/directory exists, serve it as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, if /<thing>.html exists, serve it for /<thing>
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
